                    },
                    "gmtCreate" : {
                      "type" : "long"
                    },
                    "id" : {
                      "type" : "long"
                    },
                    "memberId" : {
                      "type" : "long"
                    },
                    "orderCode" : {
                      "type" : "text"
                    },
                    "payStoreId" : {
                      "type" : "long"
                    },
                    "receivableType" : {
                      "type" : "integer"
                    },
                    "storeValuePayAmount" : {
                      "type" : "double"
                    }
                  }
                }
    }

}



